import cv2
import time

# Load face detection model
face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
)

cap = cv2.VideoCapture(0)
alert_triggered = False
start_time = time.time()

print("🚨 AI ATM Theft Detection System Running...")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    # Rule 1: More than one person inside ATM
    if len(faces) > 1:
        alert_triggered = True
        cv2.putText(frame, "MULTIPLE PERSONS DETECTED!", (30, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)

    # Rule 2: No face detected for long time (masked person)
    if len(faces) == 0 and time.time() - start_time > 10:
        alert_triggered = True
        cv2.putText(frame, "SUSPICIOUS ACTIVITY!", (30, 80),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)

    for (x, y, w, h) in faces:
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)

    if alert_triggered:
        cv2.putText(frame, "🚨 ALERT SENT TO BANK 🚨", (30, 120),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 3)

    cv2.imshow("ATM Security Feed", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
